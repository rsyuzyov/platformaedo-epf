// E2E: обработка открывается из «Дополнительных обработок» БСП так же, как ее открывает пользователь.
// Ловит то, чего не видят сборка epf и компиляция на сервере: ошибки инициализации клиентской части формы
// (1.0.5.3.8.6 - ТекущаяДатаСеанса на клиенте, 1.0.5.3.8.7 - потерянный тип реквизита Организация).
// Требования к базе: обработка зарегистрирована в разделе «Продажи», у пользователя тест-клиента команда «1»
// в быстром доступе (иначе список «Дополнительные обработки» пуст). Без КриптоПро на хосте тест-клиента
// обработка показывает сообщение о модуле криптографии - оно допустимо и закрывается.

// Без активного окна Тестер возвращает структуру без поля ID, а не Неопределено.
Функция ИмяАктивногоОкна ()
	
	Попытка
		возврат ПолучитьЭлементыАктивногоОкна ().ID;
	Исключение
		возврат "";
	КонецПопытки;
	
КонецФункции


Подключить ();
// Мастер настройки обработки модальный и не закрывается, пока настройка не выбрана: прогон - на свежем тест-клиенте.
Если СтрНачинаетсяС ( ИмяАктивногоОкна (), "ВнешняяОбработка.ОФД_ЭДО" ) Тогда
	ВызватьИсключение "окно обработки осталось от прошлого прогона (" + ИмяАктивногоОкна () + ") - перезапустить тест-клиент";
КонецЕсли;
ЗакрытьВсё ();
Меню ( "Продажи / Дополнительные обработки" );
Дождаться ( "Дополнительные обработки*", 15 );
Пауза ( 3 );
Если ПолучитьСодержимоеТаблицы ( "!ТаблицаКоманд" ).Количество () = 0 Тогда
	ВызватьИсключение "в «Дополнительные обработки (Продажи)» нет команд: нет быстрого доступа у пользователя";
КонецЕсли;
Нажать ( "!ВыполнитьОбработку" );

ДопустимыеСообщения = СтрРазделить ( "модулю криптографии", "|" );
ИмяФормы = "";
Для Шаг = 1 По 30 Цикл
	Пауза ( 2 );
	ИмяОкна = ИмяАктивногоОкна ();
	Если ИмяОкна = "ErrorWindow" Тогда
		ВызватьИсключение "окно ошибки при открытии обработки: " + Получить ( "!ErrorInfo" ).TitleText;
	КонецЕсли;
	Если ИмяОкна = "ВнешняяОбработка.ОФД_ЭДО.Форма.ФормаВыводаСообщений" Тогда
		ТекстСообщения = Получить ( "!ТекстСообщения" ).ПолучитьТекстРедактирования ();
		Допустимо = Ложь;
		Для Каждого Фрагмент Из ДопустимыеСообщения Цикл
			Допустимо = Допустимо Или СтрНайти ( ТекстСообщения, Фрагмент ) > 0;
		КонецЦикла;
		Если Не Допустимо Тогда
			ВызватьИсключение "сообщение обработки при открытии: " + ТекстСообщения;
		КонецЕсли;
		Нажать ( "!КнопкаОК" );
		Продолжить;
	КонецЕсли;
	Если ИмяОкна = "ВнешняяОбработка.ОФД_ЭДО.Форма.ГлавноеОкно" Или ИмяОкна = "ВнешняяОбработка.ОФД_ЭДО.Форма.ФормаНастройки" Тогда
		ИмяФормы = ИмяОкна;
		Прервать;
	КонецЕсли;
КонецЦикла;

Если ИмяФормы = "" Тогда
	ВызватьИсключение "за 60 с не открылась ни главная форма, ни мастер настройки";
КонецЕсли;
возврат "открыта " + ИмяФормы;
